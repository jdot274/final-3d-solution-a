<?xml version="1.0"?>
<!-- SPIN Glass LED — open-standard MaterialX 1.39 / OpenPBR-style glass.
     Portable to OpenUSD (UsdMtlx), UE 5 (Interchange MaterialX), Blender, MaterialXView. -->
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_GlassLED">
    <constant name="base_blue" type="color3">
      <input name="value" type="color3" value="0.043, 0.235, 1.0" />
    </constant>
    <!-- emissive LED grid: tiled dots -->
    <texcoord name="uv" type="vector2" />
    <multiply name="grid" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="32, 32" />
    </multiply>
    <constant name="led_color" type="color3">
      <input name="value" type="color3" value="0.1, 0.4, 1.0" />
    </constant>
  </nodegraph>

  <standard_surface name="SR_GlassLED" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_GlassLED" output="base_blue" />
    <input name="specular_roughness" type="float" value="0.06" />
    <input name="metalness" type="float" value="0.0" />
    <input name="transmission" type="float" value="0.92" />
    <input name="transmission_color" type="color3" value="0.2, 0.45, 1.0" />
    <input name="specular_IOR" type="float" value="1.45" />
    <input name="emission" type="float" value="1.4" />
    <input name="emission_color" type="color3" nodegraph="NG_GlassLED" output="led_color" />
    <input name="thin_walled" type="boolean" value="false" />
    <input name="coat" type="float" value="0.4" />
  </standard_surface>

  <surfacematerial name="M_GlassLED" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_GlassLED" />
  </surfacematerial>
</materialx>
